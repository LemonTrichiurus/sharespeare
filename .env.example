# Copy to .env.local and fill in. Never commit real values.
# Supabase Dashboard → Project Settings → API Keys → "Publishable and secret API keys"
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# The app needs no secret/service-role key: every query runs as the signed-in
# user and is authorized by Row Level Security.

# Set to "true" once a Google OAuth client is configured in Supabase
# (Authentication → Sign In / Providers → Google).
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
